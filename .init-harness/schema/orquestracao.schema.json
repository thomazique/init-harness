{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomazique/init-harness/blob/main/.init-harness/schema/orquestracao.schema.json",
  "title": "init-harness orchestration profiles and initiative protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "perguntar_a_cada_atividade",
    "limite_chamadas_cli_por_atividade",
    "timeout_segundos",
    "perfis"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "perguntar_a_cada_atividade": {"const": true},
    "limite_chamadas_cli_por_atividade": {"type": "integer", "minimum": 1, "maximum": 100},
    "timeout_segundos": {"type": "integer", "minimum": 30, "maximum": 14400},
    "perfis": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/perfil"}
    }
  },
  "$defs": {
    "agente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provedor", "modelo", "modo"],
      "properties": {
        "provedor": {"enum": ["claude", "codex"]},
        "modelo": {"type": "string", "minLength": 1},
        "modo": {"enum": ["sessao", "nativo", "cli"]},
        "raciocinio": {"enum": ["low", "medium", "high", "xhigh"]}
      }
    },
    "perfil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "descricao", "coordenador", "executor", "auditor"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
        "descricao": {"type": "string", "minLength": 1},
        "coordenador": {"$ref": "#/$defs/agente"},
        "executor": {"$ref": "#/$defs/agente"},
        "auditor": {"$ref": "#/$defs/agente"},
        "chefe": {"$ref": "#/$defs/agente"},
        "supervisor": {"$ref": "#/$defs/agente"},
        "construtor": {"$ref": "#/$defs/agente"}
      }
    },
    "limites_iniciativa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_parallel", "max_agents", "max_calls", "max_builders_per_supervisor"],
      "properties": {
        "max_parallel": {"type": "integer", "minimum": 1},
        "max_agents": {"type": "integer", "minimum": 1},
        "max_calls": {"type": "integer", "minimum": 1},
        "max_builders_per_supervisor": {"type": "integer", "minimum": 1}
      }
    },
    "frente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "team", "specialty", "spec", "repository", "branch", "base_commit", "dependencies", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "team": {"type": "string", "minLength": 1},
        "specialty": {"enum": ["frontend", "backend", "security", "deploy_cicd", "database"]},
        "spec": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "manifesto_iniciativa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "initiative_id", "profile", "limits", "fronts"],
      "properties": {
        "contract_version": {"const": 1},
        "initiative_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "profile": {"type": "string", "minLength": 1},
        "limits": {"$ref": "#/$defs/limites_iniciativa"},
        "fronts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frente"}}
      }
    },
    "tarefa_plano": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "files", "depends_on", "acceptance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "pair_with": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "plano_supervisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "interfaces", "questions"],
      "properties": {
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/tarefa_plano"}},
        "interfaces": {"type": "array", "items": {"type": "string"}},
        "questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reconciliacao_supervisores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agreements", "conflicts", "questions"],
      "properties": {
        "agreements": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "fechamento_supervisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignments", "interfaces", "questions"],
      "properties": {
        "assignments": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["task_id", "files", "builder_context"], "properties": {
            "task_id": {"type": "string", "minLength": 1},
            "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "builder_context": {"type": "string", "minLength": 1}
          }}},
        "interfaces": {"type": "array", "items": {"type": "string"}},
        "questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decisao_chefe": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["decision", "summary"], "properties": {
          "decision": {"const": "approve"}, "summary": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["decision", "questions"], "properties": {
          "decision": {"const": "ask_human"}, "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
        {"type": "object", "additionalProperties": false, "required": ["decision", "findings"], "properties": {
          "decision": {"const": "revise"}, "findings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
            "required": ["front_id", "task_id", "instruction"], "properties": {
              "front_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "instruction": {"type": "string", "minLength": 1}}}}}}
      ]
    },
    "retorno_construtor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "files_changed", "checks", "risks", "questions"],
      "properties": {
        "status": {"enum": ["completed", "blocked"]},
        "summary": {"type": "string"},
        "files_changed": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "respostas_humanas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answers"],
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer"],
            "properties": {
              "question": {"type": "string", "minLength": 1},
              "answer": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
